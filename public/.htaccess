# BTP Leads Pro — Apache/LiteSpeed config for the Next.js static export.

RewriteEngine On

# Force HTTPS.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force the apex domain (no www) so a single canonical hostname serves
# the site.
RewriteCond %{HTTP_HOST} ^www\.btpleadspro\.fr$ [NC]
RewriteRule ^ https://btpleadspro.fr%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html
